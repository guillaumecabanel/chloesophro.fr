<% meta_title = current_page.data.meta_title || current_page.data.title || data.config.metatags.title %>
<% meta_description = current_page.data.meta_description || data.config.metatags.description %>

<!-- Primary Meta Tags -->
<meta name="title" content="<%= meta_title %>">
<meta name="description" content="<%= meta_description %>">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="<%= data.config.metatags.url %>">
<meta property="og:title" content="<%= meta_title %>">
<meta property="og:description" content="<%= meta_description %>">
<meta property="og:image" content="<%= data.config.metatags.url %><%= image_path "meta-image.jpg" %>">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="<%= data.config.metatags.url %>">
<meta property="twitter:title" content="<%= meta_title %>">
<meta property="twitter:description" content="<%= meta_description %>">
<meta property="twitter:image" content="<%= data.config.metatags.url %><%= image_path "meta-image.jpg" %>">
