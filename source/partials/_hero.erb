<section
  class="bg-no-repeat bg-cover bg-center overflow-hidden"
  style="background-image: linear-gradient(rgba(255,255,255,0.6), rgba(255,255,255,0.6)), url(<%= image_path "bg-hero.webp" %>)">

  <div class="mx-auto max-w-7xl px-6 py-20 sm:py-32 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:grid lg:max-w-none lg:grid-cols-2 lg:gap-x-16 lg:gap-y-6 xl:grid-cols-1 xl:grid-rows-1 xl:gap-x-8">
      <h1 class="max-w-2xl text-4xl font-bold tracking-tight text-teal-900 sm:text-6xl lg:col-span-2 xl:col-auto mt-10 sm:mt-16 lg:mt-0 xl:mt-36">
        <%= data.hero.title %>
      </h1>
      <div class="mt-6 max-w-xl lg:mt-0 xl:col-end-1 xl:row-start-1">
        <p class="text-lg leading-8 text-gray-800">
          <%= data.hero.presentation %>
        </p>
        <%= partial "partials/cta_buttons", locals: { utm_content: "hero-cta", secondary_link: "#accompagnement", secondary_text: data.hero.secondary_action } %>
      </div>
      <%= image_tag "chloe.webp", alt: "Avatar de Chloé", class: "aspect-[6/8] w-full max-w-lg rounded-2xl object-cover lg:max-w-none xl:row-span-2 xl:row-end-2 mt-10 sm:mt-16 lg:mt-0 xl:mt-36" %>
    </div>
  </div>
</section>
